# Copy to .env and fill in values.

# --- Links so email recipients can OPEN the postcard (must be real HTTPS, not localhost) ---
# localhost / 127.0.0.1 are ignored.
#
# Minimum for working links in email: set PUBLIC_API_URL to your deployed API,
# OR deploy to Render / Railway / Fly — the app auto-uses RENDER_EXTERNAL_URL,
# RAILWAY_PUBLIC_DOMAIN, or FLY_APP_NAME when PUBLIC_API_URL is unset.
#   Recipients get: https://YOUR-API/postcard/<id>/view  (full postcard page + image)
#
# Optional: also set PUBLIC_FRONTEND_URL to your React app for ?share= links (nicer SPA).
PUBLIC_FRONTEND_URL=https://your-app.example.com
PUBLIC_API_URL=https://your-api.example.com

# --- CORS: allow any origin to open shared postcards (recommended with deployed URLs) ---
CORS_ALLOW_ALL=true

# --- Email (pick one) ---

# Resend (https://resend.com): create API key, verify domain or use onboarding@resend.dev for tests
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Postcard <onboarding@resend.dev>

# Or SMTP (Gmail, etc.) — use an App Password, not your normal Gmail password (2-Step Verification on).
# .env is read from postcard/backend/.env next to main.py (even if you start uvicorn elsewhere).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_FROM=Postcard <you@gmail.com>
# If 587 fails on your network, try: SMTP_PORT=465 and SMTP_SSL=true
